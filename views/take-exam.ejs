<!DOCTYPE html>
<html>

<head>

    <title>
        <%= exam.title %>
    </title>

    <link
        rel="stylesheet"
        href="/style.css"
    >

</head>

<body>

<nav>

    <strong>
        <%= exam.title %>
    </strong>

    <span id="timer">
        Time: <%= exam.duration %>:00
    </span>

</nav>

<div class="container">

    <div class="exam-header">

        <h1>
            <%= exam.title %>
        </h1>

        <p>
            <%= exam.description %>
        </p>

    </div>

    <form
        id="examForm"
        action="/student/exam/<%= exam.id %>/submit"
        method="POST"
    >

        <% questions.forEach((q, index) => { %>

            <div class="question-card">

                <h3>

                    <%= index + 1 %>.
                    <%= q.question %>

                </h3>

                <label class="option">

                    <input
                        type="radio"
                        name="question_<%= q.id %>"
                        value="A"
                        required
                    >

                    A.
                    <%= q.option_a %>

                </label>

                <label class="option">

                    <input
                        type="radio"
                        name="question_<%= q.id %>"
                        value="B"
                    >

                    B.
                    <%= q.option_b %>

                </label>

                <label class="option">

                    <input
                        type="radio"
                        name="question_<%= q.id %>"
                        value="C"
                    >

                    C.
                    <%= q.option_c %>

                </label>

                <label class="option">

                    <input
                        type="radio"
                        name="question_<%= q.id %>"
                        value="D"
                    >

                    D.
                    <%= q.option_d %>

                </label>

            </div>

        <% }) %>

        <button
            type="submit"
            class="submit-exam"
            onclick="return confirmSubmit()"
        >
            Submit Exam
        </button>

    </form>

</div>

<script src="/exam.js"></script>

<script>

startTimer(
    <%= exam.duration %>,
    "timer",
    "examForm"
);

</script>

</body>
</html>